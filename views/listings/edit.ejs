<% layout("/layouts/boilerplate") -%>
<div class="row">
  <div class="col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <div class="listing-form">
      <h3>Edit Listing</h3>
      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=PUT"
        enctype="multipart/form-data"
        class="needs-validation"
        novalidate
      >
        <!-- Title -->
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            name="listing[title]"
            value="<%= listing.title %>"
            type="text"
            placeholder="Update your title"
            class="form-control"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter valid title</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Please enter valid description</div>
        </div>

        <!-- Upload New Image -->
        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image (optional)</label>
          <input
            type="file"
            name="image"
            id="image"
            class="form-control"
            accept="image/*"
          />
        </div>

        <!-- Inline fields for Price + Country -->
        <div class="inline-fields">
          <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input
              name="listing[price]"
              value="<%= listing.price %>"
              class="form-control"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter valid price</div>
          </div>
          <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input
              name="listing[country]"
              value="<%= listing.country %>"
              type="text"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Country name not found!</div>
            <div class="valid-feedback">Looks good!</div>
          </div>
        </div>

        <!-- Location -->
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            name="listing[location]"
            value="<%= listing.location %>"
            type="text"
            class="form-control"
            required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-feedback">Location not found!</div>
        </div>

        <!-- Amenities -->
        <div class="mb-3">
          <label class="form-label fw-bold">Offering Services / Amenities</label>
          <div class="row row-cols-2 row-cols-md-3 g-2">
            
            <!-- Wi-Fi -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Wi-Fi" id="wifi" 
                  <%= listing.amenities.includes("Wi-Fi") ? "checked" : "" %> >
                <label class="form-check-label" for="wifi">
                  <i class="fa-solid fa-wifi"></i> Wi-Fi
                </label>
              </div>
            </div>

            <!-- Pool -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Pool" id="pool" 
                  <%= listing.amenities.includes("Pool") ? "checked" : "" %> >
                <label class="form-check-label" for="pool">
                  <i class="fa-solid fa-person-swimming"></i> Pool
                </label>
              </div>
            </div>

            <!-- Parking -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Parking" id="parking" 
                  <%= listing.amenities.includes("Parking") ? "checked" : "" %> >
                <label class="form-check-label" for="parking">
                  <i class="fa-solid fa-square-parking"></i> Parking
                </label>
              </div>
            </div>

            <!-- Air Conditioning -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Air Conditioning" id="ac" 
                  <%= listing.amenities.includes("Air Conditioning") ? "checked" : "" %> >
                <label class="form-check-label" for="ac">
                  <i class="fa-solid fa-wind"></i> Air Conditioning
                </label>
              </div>
            </div>

            <!-- Kitchen -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Kitchen" id="kitchen" 
                  <%= listing.amenities.includes("Kitchen") ? "checked" : "" %> >
                <label class="form-check-label" for="kitchen">
                  <i class="fa-solid fa-kitchen-set"></i> Kitchen
                </label>
              </div>
            </div>

            <!-- TV -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="TV" id="tv" 
                  <%= listing.amenities.includes("TV") ? "checked" : "" %> >
                <label class="form-check-label" for="tv">
                  <i class="fa-solid fa-tv"></i> TV
                </label>
              </div>
            </div>

            <!-- Washing Machine -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Washing Machine" id="wm" 
                  <%= listing.amenities.includes("Washing Machine") ? "checked" : "" %> >
                <label class="form-check-label" for="wm">
                  <i class="fa-solid fa-jug-detergent"></i> Washing Machine
                </label>
              </div>
            </div>

            <!-- Workplace -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Workplace" id="workplace" 
                  <%= listing.amenities.includes("Workplace") ? "checked" : "" %> >
                <label class="form-check-label" for="workplace">
                  <i class="fa-solid fa-chair"></i> Workplace
                </label>
              </div>
            </div>

            <!-- Pet Friendly -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Pet Friendly" id="pet" 
                  <%= listing.amenities.includes("Pet Friendly") ? "checked" : "" %> >
                <label class="form-check-label" for="pet">
                  <i class="fa-solid fa-paw"></i> Pet Friendly
                </label>
              </div>
            </div>

            <!-- Breakfast -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Breakfast" id="breakfast" 
                  <%= listing.amenities.includes("Breakfast") ? "checked" : "" %> >
                <label class="form-check-label" for="breakfast">
                  <i class="fa-solid fa-bowl-food"></i> Breakfast
                </label>
              </div>
            </div>

            <!-- Gym -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Gym" id="gym" 
                  <%= listing.amenities.includes("Gym") ? "checked" : "" %> >
                <label class="form-check-label" for="gym">
                  <i class="fa-solid fa-dumbbell"></i> Gym
                </label>
              </div>
            </div>

            <!-- Spa -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Spa" id="spa" 
                  <%= listing.amenities.includes("Spa") ? "checked" : "" %> >
                <label class="form-check-label" for="spa">
                  <i class="fa-solid fa-spa"></i> Spa
                </label>
              </div>
            </div>

            <!-- Balcony -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Balcony" id="balcony" 
                  <%= listing.amenities.includes("Balcony") ? "checked" : "" %> >
                <label class="form-check-label" for="balcony">
                  <i class="fa-solid fa-building"></i> Balcony
                </label>
              </div>
            </div>

            <!-- Fireplace -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Fireplace" id="fireplace" 
                  <%= listing.amenities.includes("Fireplace") ? "checked" : "" %> >
                <label class="form-check-label" for="fireplace">
                  <i class="fa-solid fa-fire"></i> Fireplace
                </label>
              </div>
            </div>

            <!-- Garden -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Garden" id="garden" 
                  <%= listing.amenities.includes("Garden") ? "checked" : "" %> >
                <label class="form-check-label" for="garden">
                  <i class="fa-solid fa-tree"></i> Garden
                </label>
              </div>
            </div>

            <!-- Fire Extinguisher -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Fire Extinguisher" id="extinguisher" 
                  <%= listing.amenities.includes("Fire Extinguisher") ? "checked" : "" %> >
                <label class="form-check-label" for="extinguisher">
                  <i class="fa-solid fa-fire-extinguisher"></i> Fire Extinguisher
                </label>
              </div>
            </div>

            <!-- Smoke Alarm -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Smoke Alarm" id="alarm" 
                  <%= listing.amenities.includes("Smoke Alarm") ? "checked" : "" %> >
                <label class="form-check-label" for="alarm">
                  <i class="fa-solid fa-bell"></i> Smoke Alarm
                </label>
              </div>
            </div>

            <!-- Mini Bar -->
            <div class="col">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                  name="listing[amenities]" value="Mini Bar" id="minibar" 
                  <%= listing.amenities.includes("Mini Bar") ? "checked" : "" %> >
                <label class="form-check-label" for="minibar">
                  <i class="fa-solid fa-wine-bottle"></i> Mini Bar
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Submit -->
        <button class="btn btn-dark add-btn mt-3">Edit</button>
      </form>
    </div>
  </div>
</div>
<script src="/js/script.js"></script>
