    <!-- Brand -->
    <a class="navbar-brand text-white" href="/listings">
      <i class="fa-regular fa-compass"></i> WanderLust
    </a>

    <!-- Search bar (always visible on desktop) -->
    <div id="search-bar" class="flex-grow-1 mx-3 d-none d-lg-block">
      <form class="d-flex w-100" role="search">
        <div class="input-group w-100">
          <!-- Dropdown -->
          <button
            class="btn dropdown-toggle all-search"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            
          >
            All
          </button>
          <ul class="dropdown-menu drop-bar">
            <li><a class="dropdown-item" href="#">Hotel</a></li>
            <li><a class="dropdown-item" href="#">Resort</a></li>
            <li><a class="dropdown-item" href="#">Vacation House</a></li>
            <li><a class="dropdown-item" href="#">Apartment</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="#">Private Rooms</a></li>
            <li><a class="dropdown-item" href="#">Shared Rooms</a></li>
          </ul>

          <!-- Input -->
          <input
            type="text"
            class="form-control"
            placeholder="Search"
            aria-label="Search"
          />

          <!-- Button -->
          <button
            class="btn"
            type="submit"
            id="search"
            style="background-color: #e63946; color: white"
          >
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </form>
    </div>

    <!-- Mobile search toggle (🔍 icon replaced with bar when clicked) -->
    <div class="d-lg-none" id="searchIconWrapper">
      <button class="btn btn-outline-light me-2" id="toggleSearch">
        <i class="fa fa-search"></i>
      </button>
    </div>

    <!-- Navbar toggler -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collapsible nav links -->
    <div
      class="collapse navbar-collapse"
      id="navbarNavAltMarkup"
      style="background-color: #1d3557"
