<% layout("/layouts/boilerplate") -%>
<!--breadcrumb-->
<div class="stepper">
  <div class="step done">
    <i class="fa-solid fa-book-open me-1"></i>
    <span class="step-text">Listing</span>
  </div>
  <div class="step active">
    <i class="fa-solid fa-clipboard-check me-1"></i>
    <span class="step-text">Preview</span>
  </div>
  <div class="step upcoming">
    <i class="fas fa-wallet me-1"></i>
    <span class="step-text">Payment</span>
  </div>
  <div class="step upcoming">
    <i class="fa-regular fa-circle-check me-1"></i>
    <span class="step-text">Confirmation</span>
  </div>
</div>
<div class="container my-5">
  <div class="row">
    <!-- Left: Trip details -->
    <div class="col-md-6 mb-4">
      <div class="card card-custom p-3">
        <h5 class="text-danger border-bottom pb-2">
          <i class="fas fa-bed me-2"></i> Confirm Your Accommodation
        </h5>
        <!-- Dates -->
        <h6 class="d-flex align-items-center mt-3">
          <div class="icon-circle icon-navy me-2">
            <i class="fas fa-calendar-alt"></i>
          </div>
          Dates
        </h6>
        <p>Check-in: <%= reservation.checkInDate %></p>
        <p>Checkout: <%= reservation.checkOutDate %></p>

        <div class="edit-link mb-3">
          <button onclick="window.history.back()" class="btn-edit">Edit</button>
        </div>

        <!-- Guests -->
        <h6 class="d-flex align-items-center">
          <div class="icon-circle icon-navy me-2">
            <i class="fas fa-users"></i>
          </div>
          Guests
        </h6>
        <p><%= reservation.guests %></p>
        <div class="edit-link mb-3">
          <button onclick="window.history.back()" class="btn-edit">Edit</button>
        </div>
      </div>
    </div>

    <!-- Right: Pricing -->
    <div class="col-md-6 mb-4">
      <div class="card card-custom p-3">
        <h5 class="text-danger border-bottom pb-2">
          <i class="fas fa-home me-2"></i> <%= reservation.propertyTitle %>
        </h5>

        <h6 class="mt-3">Your Total</h6>
        <p>
          <span class="badge-pill"><%= reservation.nights %> Nights</span>
          × ₹<%= reservation.pricePerNight.toLocaleString("en-IN") %>
        </p>

        <div class="d-flex justify-content-between">
          <p class="mb-1">Subtotal:</p>
          <p class="mb-1">
            ₹<%= reservation.totalPriceBeforeTax.toLocaleString("en-IN") %>
          </p>
        </div>

        <div class="d-flex justify-content-between">
          <p class="mb-1">Taxes:</p>
          <p class="mb-1">₹<%= reservation.taxAmount.toFixed(2) %></p>
        </div>
        <hr />
        <div class="d-flex justify-content-between fw-bold fs-5">
          <p class="mb-0 total-label">Total (INR):</p>
          <p class="mb-0 total-amount">
            ₹<%= reservation.finalTotal.toLocaleString("en-IN") %>
          </p>
        </div>

        <form action="/reservations/payment" method="GET">
          <button type="submit" class="btn-pay">
            <i class="fas fa-credit-card me-2"></i> Book
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
<script src="/public/js/script.js"></script>
