<% layout("/layouts/boilerplate") -%>
<!--breadcrumb-->
<div class="stepper">
  <div class="step done">
    <i class="fa-solid fa-book-open me-1"></i>
    <span class="step-text">Listing</span>
  </div>
  <div class="step done">
    <i class="fa-solid fa-clipboard-check me-1"></i>
    <span class="step-text">Preview</span>
  </div>
  <div class="step done">
    <i class="fas fa-wallet me-1"></i>
    <span class="step-text">Payment</span>
  </div>
  <div class="step active">
    <i class="fa-regular fa-circle-check me-1"></i>
    <span class="step-text">Confirmation</span>
  </div>
</div>
<div class="container mt-5">
  <!-- Card wrapper -->
  <div class="card shadow-lg border-0 rounded-3">
    <div class="card-body p-4">
      <!-- Success Badge -->
      <div class="text-center mb-3">
        <span class="badge fs-6 px-3 py-2 flash-badge">
          ✔ Reservation Confirmed
        </span>
      </div>

      <!-- Heading -->
      <div class="confirmation-card">
        <h2 class="text-center mb-4 fw-bold">Reservation Confirmation</h2>
        <hr />

        <!-- Property Name -->
        <h4 class="text-coral mb-3"><%= reservation.propertyTitle %></h4>

        <!-- Booking Details -->
        <div class="mb-3">
          <p>
            <strong class="text">check in:</strong
            ><span> <%= reservation.checkInDate %></span>
          </p>
          <p>
            <strong class="text">check out:</strong>
            <span> <%= reservation.checkOutDate %></span>
          </p>
          <p>
            <strong class="text">Guests:</strong>
            <span><%= reservation.guests %></span>
          </p>
          <p>
            <strong class="nights-chip"
              >Nights: <%= reservation.nights %>
            </strong>
          </p>
        </div>
      </div>

      <!-- Price Breakdown -->
      <div class="bg-offwhite p-4 rounded-3 shadow-lg">
        <div class="d-flex justify-content-between mb-2">
          <span>Price per night:</span>
          <span
            >₹<%= reservation.pricePerNight.toLocaleString("en-IN",
            {minimumFractionDigits: 2}) %></span
          >
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Total price:</span>
          <span
            >₹<%= reservation.totalPrice.toLocaleString("en-IN",
            {minimumFractionDigits: 2}) %></span
          >
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span>Tax (3%):</span>
          <span
            >₹<%= reservation.taxAmount.toLocaleString("en-IN",
            {minimumFractionDigits: 2}) %></span
          >
        </div>
        <hr class="my-3" />
        <div class="d-flex justify-content-between fw-bold fs-4 paid-amount">
          <span> Paid Amount: </span>
          <span
            >₹<%= reservation.finalTotal.toLocaleString("en-IN",
            {minimumFractionDigits: 2}) %></span
          >
        </div>
      </div>

      <!-- Back Button -->
      <div class="text-center mt-4">
        <a href="/listings" class="btn px-4 py-2 confirmation-btn">
          Back to Home
        </a>
      </div>
    </div>
  </div>
</div>
